{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Edge firmware",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/pio",
      "windows": {
        "command": "${userHome}/.platformio/penv/Scripts/pio.exe"
      },
      "args": ["run", "-e", "edge"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
